# ─────────────────────────────────────────────────────────────
#  NDR | Demon Slayer — Backend API
#  Copier ce fichier en `.env` et remplir les valeurs.
#  NE JAMAIS committer le fichier `.env`.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# Mettre à true si l'API est derrière un reverse proxy (nginx, Caddy, Cloudflare…)
TRUST_PROXY=false

# Connexion PostgreSQL
DATABASE_URL=postgres://dsrp:CHANGE_ME@127.0.0.1:5432/dsrp

# Secret de signature des access tokens (64+ caractères aléatoires).
# Générer avec :  node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=

# Durées de vie
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TTL_REMEMBER_DAYS=30
REFRESH_TTL_SESSION_HOURS=12

# Anti brute-force
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=10
GLOBAL_RATE_LIMIT_PER_MINUTE=120

# Origines autorisées en CORS (séparées par des virgules).
# Le launcher .exe passe par Rust et n'a PAS besoin de CORS.
# Utile uniquement pour le mode navigateur en développement.
CORS_ORIGINS=http://localhost:1420

# Inscriptions ouvertes depuis le launcher
REGISTRATION_ENABLED=true

# E-mails (mot de passe oublié). Sans SMTP_URL, les codes sont affichés
# dans la console en développement uniquement.
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="NDR Demon Slayer <no-reply@example.com>"

# Informations publiques renvoyées au launcher (/api/launcher/config)
PUBLIC_SERVER_NAME=NDR | Demon Slayer
PUBLIC_DISCORD_URL=
PUBLIC_WEBSITE_URL=
PUBLIC_SUPPORT_EMAIL=

# Appliquer automatiquement les migrations au démarrage
AUTO_MIGRATE=false
